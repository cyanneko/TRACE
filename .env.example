PORT=8787
VISION_PROVIDER=fixture

# Remote providers: deepseek, glm, doubao, or custom.
# Presets supply a default base URL and model; every value can be overridden.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Optional compatibility controls for custom endpoints.
VISION_CUSTOM_ID=
VISION_IMAGE_DETAIL=
VISION_IMAGE_FORMAT=
VISION_JSON_MODE=

# Public production relays allow the built-in provider hosts. Add comma-separated
# HTTPS hosts here only when enabling user-supplied custom endpoints.
VISION_USER_HOST_ALLOWLIST=

# Preset defaults:
# deepseek -> https://api.deepseek.com / deepseek-v4-flash-vision-exp
# glm      -> https://open.bigmodel.cn/api/paas/v4 / glm-4.6v-flash
# doubao   -> https://ark.cn-beijing.volces.com/api/v3 / doubao-seed-2-0-lite-260215
