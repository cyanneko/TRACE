{
  "name": "trace",
  "version": "0.1.0",
  "private": true,
  "description": "Thread Reasoning, Action, Context & Execution",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @trace/api",
    "dev:web": "npm run web --workspace @trace/mobile",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build:web --workspace @trace/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm test"
  },
  "packageManager": "npm@10.9.8"
}
