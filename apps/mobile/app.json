{
  "expo": {
    "name": "TRACE",
    "slug": "trace",
    "version": "1.0.0",
    "scheme": "trace",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/trace-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.cyanneko.trace",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/trace-icon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TRACE to open the chat screenshot you choose for analysis."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow TRACE to match conversation participants and apply only the contact changes you confirm."
        }
      ],
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Allow TRACE to add only the meetings you explicitly confirm."
        }
      ],
      "expo-sqlite"
    ]
  }
}
